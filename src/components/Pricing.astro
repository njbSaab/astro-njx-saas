---
// Pricing: data-driven plans + an Alpine monthly/yearly toggle.
// Prices are rendered into x-text expressions so the toggle stays live.
const PLANS = [
  {
    name: 'Hobby',
    monthly: 0,
    yearly: 0,
    note: 'forever',
    features: ['1 project', 'Preview deploys', 'Community support'],
    card: 'card',
    btn: 'btn btn-outline',
    btnLabel: 'Start free',
    popular: false,
  },
  {
    name: 'Pro',
    monthly: 19,
    yearly: 15,
    note: null,
    features: ['Unlimited projects', 'Rollbacks & analytics', 'Priority support'],
    card: 'card-outline-gradient',
    btn: 'btn btn-gradient hover-lift',
    btnLabel: 'Start 14-day trial',
    popular: true,
  },
  {
    name: 'Team',
    monthly: 49,
    yearly: 39,
    note: null,
    features: ['Everything in Pro', 'SSO & audit log', 'SLA 99.99%'],
    card: 'card',
    btn: 'btn btn-outline-gradient btn-outline-gradient-ocean',
    btnLabel: 'Contact sales',
    popular: false,
  },
];
---

<section class="section" id="pricing" x-data="{ yearly: false }">
  <div class="container">
    <div class="text-center mb-6">
      <span class="tag tag-primary">Pricing</span>
      <h2 class="title-lg mt-3">Simple plans, no surprises</h2>
      <div class="flex justify-center items-center gap-3 mt-5">
        <button class="btn btn-sm" :class="yearly ? 'btn-ghost' : 'btn-primary'" @click="yearly = false">Monthly</button>
        <button class="btn btn-sm" :class="yearly ? 'btn-primary' : 'btn-ghost'" @click="yearly = true">
          Yearly <span class="tag tag-success">−20%</span>
        </button>
      </div>
    </div>
    <div class="grid-col-3 gap-6 items-stretch">
      {PLANS.map((p) => (
        <div class={`${p.card} p-6`}>
          <div class="flex items-center gap-2">
            <h3>{p.name}</h3>
            {p.popular && <span class="badge badge-primary" style="padding:0 10px">Popular</span>}
          </div>
          {p.monthly === 0 ? (
            <div class="text-3xl font-bold mt-3 text-gradient-primary">$0</div>
          ) : (
            <div class="text-3xl font-bold mt-3 text-gradient-primary">
              $<span x-text={`yearly ? ${p.yearly} : ${p.monthly}`}>{p.monthly}</span>
              <span class="text-sm text-muted">/mo</span>
            </div>
          )}
          {p.note ? (
            <p class="text-sm text-muted">{p.note}</p>
          ) : (
            <p class="text-sm text-muted" x-text="yearly ? 'billed yearly' : 'billed monthly'">billed monthly</p>
          )}
          <ul class="mt-4 text-muted" style="list-style:none;padding:0">
            {p.features.map((f) => (
              <li class="flex items-center gap-2 mt-2">
                <span class="badge badge-success">✓</span> {f}
              </li>
            ))}
          </ul>
          <a class={`${p.btn} mt-5`} style="width:100%;justify-content:center" href="#">{p.btnLabel}</a>
        </div>
      ))}
    </div>
  </div>
</section>
