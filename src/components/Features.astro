---
// Three showcase card styles: card-aura / card-shine / card-outline-gradient.
// `card` picks the style, `muted: false` is for card-shine (its background
// swallows .text-muted — plain text with opacity reads better).
const FEATURES = [
  {
    card: 'card-aura',
    icon: '🎨',
    title: 'Themeable by design',
    text: 'Nine themes out of the box. Switch with <code>data-theme</code> — every component follows.',
    muted: true,
  },
  {
    card: 'card-shine',
    icon: '🏔',
    title: 'Alpine-friendly',
    text: 'Components are plain classes — sprinkle <code>x-data</code> on top and they come alive.',
    muted: false,
  },
  {
    card: 'card-outline-gradient',
    icon: '📦',
    title: 'Copy-paste blocks',
    text: 'Heroes, pricing, FAQs, modals, carousels — grab the markup from the docs and go.',
    muted: true,
  },
];
---

<section class="section" id="features">
  <div class="container">
    <div class="sec-head">
      <span class="tag tag-primary">Features</span>
      <h2 class="title-lg">Why teams pick njX</h2>
    </div>
    <div class="grid-col-3 gap-6">
      {FEATURES.map((f) => (
        <div class={`${f.card} hover-lift p-6`}>
          <div class="text-3xl">{f.icon}</div>
          <h3>{f.title}</h3>
          <p class={f.muted ? 'text-muted' : undefined} style={f.muted ? undefined : 'opacity:.85'} set:html={f.text} />
        </div>
      ))}
    </div>
  </div>
</section>
