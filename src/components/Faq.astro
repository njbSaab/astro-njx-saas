---
// FAQ on native <details> — njX .accordion/.collapse classes, zero JS.
const FAQ = [
  {
    q: 'Can I self-host?',
    a: 'Yes — the Team plan includes a self-hosted runner you can drop into your own cloud.',
  },
  {
    q: 'What frameworks are supported?',
    a: 'Anything that builds to static files or a Node server: Astro, Next, plain HTML — you name it.',
  },
  {
    q: 'How do rollbacks work?',
    a: 'Every deploy is immutable. Rolling back just re-points traffic to a previous build — instant and safe.',
  },
];
---

<section class="section" id="faq">
  <div class="container" style="max-width:720px">
    <h2 class="title-lg text-center mb-6">Questions &amp; answers</h2>
    <div class="accordion">
      {FAQ.map((item) => (
        <details class="collapse">
          <summary class="collapse-header">{item.q} <span class="collapse-icon"></span></summary>
          <div class="collapse-body">{item.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>
