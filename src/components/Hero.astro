---
// Hero: njX signature gradient banner + a live "deploy" widget.
---

<section class="section hero-glow">
  <div class="container grid-col-2 gap-8 items-center">
    <div>
      <span class="tag tag-primary">Public beta · v2.0</span>
      <h1 class="title-hero fluid mt-4" style="margin-bottom: var(--space-4) !important;">
        Ship your product <span class="text-gradient-primary">weeks earlier</span>
      </h1>
      <p class="text-lead text-muted mt-4">
        Nimbus handles deploys, previews and rollbacks so your team ships
        features — not infrastructure. Connect a repo and go live in minutes.
      </p>
      <div class="flex gap-3 mt-6 flex-wrap">
        <a class="btn btn-gradient btn-lg hover-lift" href="#pricing">Start free →</a>
        <a class="btn btn-outline btn-lg" href="#features">See how it works</a>
      </div>
      <p class="text-sm text-muted mt-4">No credit card · Free tier forever</p>
    </div>

    <div class="card-glass p-6 animate-fade-in-up">
      <div class="flex items-center justify-between gap-2 mb-4 flex-wrap">
        <span class="tag tag-success animate-pulse">● deploy · live</span>
        <span class="text-sm text-muted">main → production</span>
      </div>
      <div class="progress"><div class="progress-bar" style="width:82%"></div></div>
      <div class="flex items-center justify-between text-sm text-muted mt-2">
        <span>build 82%</span><span>~24s left</span>
      </div>
      <div class="grid-col-3 gap-4 mt-5 text-center">
        <div>
          <div class="text-2xl font-bold text-gradient-primary">1.9s</div>
          <div class="text-sm text-muted">avg build</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-gradient-primary">99.99%</div>
          <div class="text-sm text-muted">uptime</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-gradient-primary">140+</div>
          <div class="text-sm text-muted">deploys/day</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- social proof strip -->
<section class="section" style="padding-top:0;padding-bottom:24px">
  <div class="container text-center">
    <p class="text-sm text-muted mb-3">Trusted by teams shipping every day</p>
    <div class="flex justify-center items-center gap-3 flex-wrap">
      <span class="tag tag-primary">▲ Vantage</span>
      <span class="tag tag-accent">◆ Kite Labs</span>
      <span class="tag tag-success">● Loopdesk</span>
      <span class="tag tag-warning">■ Fathom</span>
      <span class="tag tag-filled-primary">✦ Northbeam</span>
    </div>
  </div>
</section>
