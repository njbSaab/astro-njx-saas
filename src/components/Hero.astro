---
// Full-viewport hero (100dvh) with the signature glow, a copyable CDN pill
// and two CTAs. The pill's copy state lives on <body> (Layout.astro).
import { SITE } from '../config';
---

<section class="hero-glow hero-full" id="top">
  <div class="container text-center" style="max-width:880px">
    <span class="tag tag-primary">njX UI · CDN CSS library for landing pages</span>
    <h1 class="title-hero fluid hero-title">
      One link.<br /><span class="text-gradient-primary">Whole landing.</span>
    </h1>
    <p class="text-lead text-muted">
      Drop the CDN link, copy a block, ship a page. Buttons, cards, gradients,
      nine themes and Alpine-friendly interactivity — no build step, nothing to install.
    </p>
    <!-- CDN tag — click to copy -->
    <button class="cdn-pill" @click="copyCdn()" title="Copy the <link> tag">
      <span class="cdn-pill-lt">&lt;link&gt;</span>
      <span class="cdn-pill-url">{SITE.cdnUrl}</span>
      <span class="tag tag-success" x-show="copied" x-cloak>✓ copied</span>
      <span class="cdn-pill-copy" x-show="!copied">⧉</span>
    </button>
    <div class="flex justify-center gap-3 flex-wrap">
      <a class="btn btn-gradient btn-lg hover-lift" href={SITE.quickstart} target="_blank" rel="noopener">Get started →</a>
      <a class="btn btn-outline-gradient btn-outline-gradient-ocean btn-lg" href={SITE.github} target="_blank" rel="noopener">★ Star on GitHub</a>
    </div>
  </div>
</section>
