---
// Sticky glass header: gradient logo · anchor links · theme dots · GitHub button.
// Menu/theme state lives on <body> (see Layout.astro) — the burger and the
// mobile dropdown share it.
import { SITE } from '../config';
import GithubIcon from './GithubIcon.astro';

const LINKS = [
  { href: '#about', label: 'About' },
  { href: '#features', label: 'Features' },
  { href: '#showcase', label: 'Showcase' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#contact', label: 'Contact' },
];
---

<nav class="snav">
  <a class="snav-logo" href="#top">{SITE.name}</a>
  <span class="snav-ver">{SITE.badge}</span>
  <div class="snav-links">
    {LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
  </div>
  <div class="snav-spacer"></div>
  <div class="starter-themes" title="Switch theme">
    <template x-for="t in themes" x-bind:key="t">
      <button
        class="starter-dot"
        :class="{ 'is-active': theme === t }"
        :style="'background:' + colors[t]"
        :aria-label="t"
        @click="setTheme(t)"></button>
    </template>
  </div>
  <a class="snav-github" href={SITE.github} target="_blank" rel="noopener">
    <GithubIcon />
    GitHub
  </a>
  <button
    class="btn btn-ghost btn-sm starter-burger"
    aria-label="Menu"
    @click="menu = !menu"
    x-text="menu ? '✕' : '☰'"></button>
</nav>

<!-- mobile menu: dimmed backdrop + floating glass panel -->
<div
  class="starter-backdrop"
  x-show="menu"
  x-cloak
  x-transition.opacity.duration.200ms
  @click="menu = false">
</div>
<div class="starter-menu" x-show="menu" x-cloak x-transition.duration.200ms>
  {LINKS.map((l) => (
    <a href={l.href} @click="menu = false">{l.label}</a>
  ))}
  <div class="starter-menu-label">Theme</div>
  <div class="starter-themes">
    <template x-for="t in themes" x-bind:key="t">
      <button
        class="starter-dot"
        :class="{ 'is-active': theme === t }"
        :style="'background:' + colors[t]"
        :aria-label="t"
        @click="setTheme(t)"></button>
    </template>
  </div>
  <a class="starter-menu-github" href={SITE.github} target="_blank" rel="noopener" @click="menu = false">
    <GithubIcon />
    Star on GitHub
  </a>
</div>
